# AI provider: "gemini", "groq", or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Optional chat-model override for the selected provider.
AI_MODEL=

# Palm image analysis uses a vision-capable model independently of AI_MODEL.
# Groq default: qwen/qwen3.6-27b (vision). Do not use the retired Llama 4 Scout model.
PALM_GROQ_MODEL=qwen/qwen3.6-27b
# Gemini default: gemini-2.5-flash
PALM_GEMINI_MODEL=gemini-2.5-flash

# Supabase Auth and private report storage (required only for account features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for durable shared rate limits and permanent account deletion.
# Never prefix this key with NEXT_PUBLIC_ and never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional public application URL (used by deployment/configuration docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Do not add provider secrets or a Supabase service-role key to NEXT_PUBLIC_* variables.
# Birthplace lookup currently uses the public OpenStreetMap Nominatim service and its usage policy.
