# AI provider: "gemini" or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional override; defaults are gemini-2.5-flash / gpt-4.1-mini
AI_MODEL=

# Supabase Auth and private report storage (required only for account features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional public application URL (used by deployment/configuration docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Do not add provider secrets or a Supabase service-role key to NEXT_PUBLIC_* variables.
# Birthplace lookup currently uses the public OpenStreetMap Nominatim service and its usage policy.
